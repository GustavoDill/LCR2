PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK Configuration
# Option 1: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Raw JSON string of service account (ideal for Docker / CI / Cloud envs)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option 3: Standard GCP application credentials environment variable
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Development mode fallback (if true, bypasses Firebase Auth when in local dev mode)
DEV_ALLOW_ANONYMOUS=true
