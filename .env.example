# ==============================================================================
# BISPADO & CONSELHO DA ALA - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Configuration
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# Firebase Admin (Backend)
# Option 1: Path to service-account.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option 2: JSON string containing the service account
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Option 3: Just the Project ID (useful if running in Google Cloud Run / App Engine)
FIREBASE_PROJECT_ID=sua-ala-bosque-firebase

# E-mail Server Configuration (SMTP) - Notificações de Tickets e Atividades
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu.email.bispado@gmail.com
SMTP_PASS=sua_senha_de_app_16_letras
SMTP_FROM="Bispado Ala Bosque" <seu.email.bispado@gmail.com>

# Frontend Firebase Client (Optional, used for client-side Auth)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=sua-ala-bosque-firebase.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sua-ala-bosque-firebase
VITE_FIREBASE_STORAGE_BUCKET=sua-ala-bosque-firebase.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
